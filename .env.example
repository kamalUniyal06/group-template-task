# Copy to .env.local and adjust.

# Where the browser sends API calls. "/crm" uses the Vite dev proxy below.
# For a production build point it at the CRM directly, e.g. https://tasks.outrightcrm.in
VITE_CRM_URL=/crm

# Dev proxy target for /crm (the local XAMPP install).
CRM_PROXY_TARGET=http://localhost/taskscrm

# Must match $secret in custom/outright_products/task_manager/entryPoints/smart_gateway.php
VITE_GATEWAY_SECRET=MY_SUPER_SECRET_123
# Date format SmartGateway returns (the "datef" setting in the CRM config.php; m/d/Y by default).
# VITE_CRM_DATE_FORMAT=m/d/Y
